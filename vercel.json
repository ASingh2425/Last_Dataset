{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js?_path=/api/$1"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/purple",
      "destination": "/public/purple/index.html"
    },
    {
      "source": "/admin",
      "destination": "/public/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js?_path=/$1"
    }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 30,
      "includeFiles": "{public/**,config/**,server_data/**,data/**}"
    }
  }
}
